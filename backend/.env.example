# ---- Required ----
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (default: gemini-4-hydrogen)
# GEMINI_MODEL=
# Optional thinking level: minimal, low, medium or high (default: model default)
# GEMINI_THINKING_LEVEL=

SUPABASE_URL=https://your-project.supabase.co
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Used to verify user sessions.
SUPABASE_ANON_KEY=

# ---- Access ----
# Comma-separated admin emails (reviewers of community observations).
ADMIN_EMAILS=you@example.org
# Public URL of the frontend, used in emails.
FRONTEND_URL=http://localhost:3000
# Extra allowed browser origins, comma-separated (Vercel previews are allowed by default).
# CORS_ORIGINS=https://algae.example.org

# ---- Storage ----
# Private bucket for raw uploads; public bucket for approved, published images.
UPLOADS_BUCKET=uploads
PUBLIC_BUCKET=algae_images
SIGNED_URL_TTL_SECONDS=3600

# ---- Limits (per rolling 24 hours) ----
ANON_DAILY_IDENTIFY_LIMIT=3
USER_DAILY_IDENTIFY_LIMIT=100
MAX_UPLOAD_MB=20

# ---- Optional email notifications ----
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_USE_TLS=true
